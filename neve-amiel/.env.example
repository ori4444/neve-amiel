# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Recommended: use the "Transaction pooler" URL from Supabase → Settings → Database
# It uses port 6543 and handles serverless connection spikes via pgBouncer.
#
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
